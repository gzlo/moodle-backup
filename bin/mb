#!/bin/bash
# =============================================================================
# MB (MOODLE BACKUP) - CLI Tool
# =============================================================================
# Sistema de backup automatizado para Moodle con soporte multi-configuración,
# streaming a cloud storage, y notificaciones por email.
#
# Instalación: /usr/local/bin/mb → /opt/moodle-backup/bin/mb
# Versión: 5.3.0
# =============================================================================

set -euo pipefail

# Detectar directorio de instalación (resuelve symlink)
MB_SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || echo "$0")"
MB_INSTALL_DIR="${MB_INSTALL_DIR:-$(cd "$(dirname "$MB_SCRIPT_PATH")/.." 2>/dev/null && pwd)}"
export MB_INSTALL_DIR

# Cargar librerías
for lib in utils logging config notifications notifications_webhook backup_maintenance backup_streaming backup_orchestrator server_detect backup_lock backup_encryption backup_incremental update i18n; do
    if [ -f "${MB_INSTALL_DIR}/lib/${lib}.sh" ]; then
        # shellcheck disable=SC1090
        source "${MB_INSTALL_DIR}/lib/${lib}.sh"
    else
        echo "[ERROR] Librería no encontrada: ${MB_INSTALL_DIR}/lib/${lib}.sh" >&2
        exit 1
    fi
done

# Re-inicializar colores con argumentos actuales
setup_colors "$@"

# Cargar locale para i18n
load_locale

# =============================================================================
# FUNCIONES DE PRESENTACIÓN
# =============================================================================

show_banner() {
    echo -e "${YELLOW}"
    cat << 'BANNER'
    __  ___                 ____        ___               __                
   /  |/  /___  ____  ____/ / /__     / _ ) ___ _ ____  / /__ __ __  ___   
  / /|_/ / __ \/ __ \/ __  / / _ \   / _  |/ _ `// __/ /  '_// // / / _ \  
 / /  / / /_/ / /_/ / /_/ / /  __/  /____/ \_,_/ \__/ /_/\_\ \_,_/ / .__/  
/_/  /_/\____/\____/\__,_/_/\___/                                  /_/     
BANNER
    echo -e "${NC}"
    echo -e "  ${GREEN}MB v${MB_VERSION}${NC} — $(_ mb_tagline)"
    echo -e "  ${BLUE}Cloud Storage${NC} · ${BLUE}Streaming${NC} · ${BLUE}Multi-config${NC} · ${BLUE}Notificaciones${NC}"
    echo ""
}

show_help() {
    show_banner
    echo -e "${YELLOW}━━━ $(_ title_main) ━━━${NC}
  ${BLUE}backup <config>${NC}         $(_ cmd_backup)
  ${BLUE}run <config>${NC}            $(_ cmd_run)
  ${BLUE}list${NC}                    $(_ cmd_list)
  ${BLUE}status${NC}                  $(_ cmd_status)
  ${BLUE}detect${NC}                  $(_ cmd_detect)
  ${BLUE}logs <config>${NC}           $(_ cmd_logs)
  ${BLUE}test <config>${NC}           $(_ cmd_test)
  ${BLUE}test-email <config>${NC}     $(_ cmd_test_email)
  ${BLUE}cron${NC}                    $(_ cmd_cron)
      ${BLUE}health <config>${NC}         $(_ cmd_health)
    ${BLUE}update check <config>${NC}   $(_ cmd_update_check)
    ${BLUE}update install <config>${NC} $(_ cmd_update_install)

${YELLOW}━━━ $(_ title_config) ━━━${NC}
  ${BLUE}moodlesite list${NC}             $(_ cmd_ms_list)
  ${BLUE}moodlesite enable <config>${NC}  $(_ cmd_ms_enable)
  ${BLUE}moodlesite disable <config>${NC} $(_ cmd_ms_disable)
  ${BLUE}moodlesite create <config>${NC}  $(_ cmd_ms_create)
  ${BLUE}moodlesite show <config>${NC}    $(_ cmd_ms_show)
  ${BLUE}moodlesite test <config>${NC}    $(_ cmd_ms_test)

${YELLOW}━━━ $(_ title_options) ━━━${NC}
  ${BLUE}--no-color${NC}              $(_ opt_no_color)
  ${BLUE}--dry-run${NC}              $(_ opt_dry_run)
  ${BLUE}--version, -v${NC}           $(_ opt_version)
  ${BLUE}--help, -h${NC}              $(_ opt_help)

${YELLOW}━━━ $(_ title_examples) ━━━${NC}
  ${GREEN}mb list${NC}
  ${GREEN}mb backup ivama${NC}
  ${GREEN}mb backup --dry-run ivama${NC}
  ${GREEN}mb health ivama${NC}
  ${GREEN}mb moodlesite enable ivama${NC}
  ${GREEN}mb logs ivama${NC}"
}

show_status() {
    echo -e "${YELLOW}=== $(_ status_title) v${MB_VERSION} ===${NC}"
    echo ""
    
    echo -e "${BLUE}$(_ status_install):${NC}"
    echo -e "  📁 $MB_INSTALL_DIR"
    echo ""
    
    echo -e "${BLUE}$(_ status_scripts):${NC}"
    for lib in config logging notifications utils backup_maintenance backup_streaming backup_orchestrator; do
        if [ -f "${MB_INSTALL_DIR}/lib/${lib}.sh" ]; then
            echo -e "  ✅ lib/${lib}.sh"
        else
            echo -e "  ❌ lib/${lib}.sh"
        fi
    done
    echo ""
    
    echo -e "${BLUE}$(_ status_configs):${NC}"
    list_available_configs
    echo ""
    
    echo -e "${BLUE}$(_ status_deps):${NC}"
    for cmd in mysql mysqldump php tar gzip zip rclone; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo -e "  ✅ $cmd"
        else
            echo -e "  ❌ $cmd"
        fi
    done
    
    if command -v rclone >/dev/null 2>&1; then
        echo ""
        echo -e "${BLUE}$(_ status_rclone):${NC}"
        rclone listremotes 2>/dev/null | sed 's/^/  /' || echo "  (ninguno)"
    fi
}

show_logs() {
    local config="$1"
    if [ -z "$config" ]; then
        show_message "error" "$(_ err_usage_logs)"
        return 1
    fi
    
    if ! load_moodle_config "$config"; then
        show_message "error" "$(_ err_config_not_found): $config"
        return 1
    fi
    
    local today
    today=$(date '+%d-%m-%Y')
    local log_file="$BACKUP_BASE/$INSTANCE_NAME/$today/${INSTANCE_NAME}_backup_log_$today.log"
    
    if [ -f "$log_file" ]; then
        show_message "info" "Log: $log_file"
        tail -f "$log_file"
    else
        show_message "warning" "$(_ info_log_not_found)"
        show_message "info" "$(_ info_searching_logs)"
        find "$BACKUP_BASE/$INSTANCE_NAME/" -name "*.log" -type f -mtime -7 2>/dev/null | sort -r | head -5
    fi
}

run_background() {
    local config="$1"
    if [ -z "$config" ]; then
        show_message "error" "$(_ err_usage_run)"
        return 1
    fi
    
    if ! load_moodle_config "$config"; then
        show_message "error" "$(_ err_config_not_found): $config"
        return 1
    fi

    if is_backup_running "$INSTANCE_NAME"; then
        # shellcheck disable=SC2059
        show_message "error" "$(printf "$(_ err_backup_running)" "$INSTANCE_NAME")"
        return 1
    fi

    local nohup_log
    nohup_log="/tmp/backup_${INSTANCE_NAME}_$(date +%d%m%Y_%H%M).log"
    
    show_message "info" "$(_ info_running_bg)"
    echo "�� Configuración: $config"
    echo "🏢 Instancia: $INSTANCE_NAME"
    echo "📄 Log: $nohup_log"
    
    local mb_path
    mb_path=$(command -v mb 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")
    nohup "$mb_path" backup "$config" > "$nohup_log" 2>&1 &
    local pid=$!
    
    echo "✅ Proceso iniciado (PID: $pid)"
    echo "📧 Notificaciones a: $NOTIFICATION_EMAIL"
    echo ""
    echo "🔍 Monitorear: tail -f $nohup_log"
    
    sleep 4
    if ps -p "$pid" >/dev/null 2>&1; then
        echo "✅ Confirmado: proceso ejecutándose"
    else
        show_message "error" "El proceso no se inició"
        return 1
    fi
}

handle_moodlesite() {
    local subcmd="${1:-list}"
    shift 2>/dev/null || true
    
    case "$subcmd" in
        list)     list_available_configs ;;
        enable)   enable_config "$1" ;;
        disable)  disable_config "$1" ;;
        create)   create_config "$1" ;;
        show)     show_config_info "$1" ;;
        test)     test_config "$1" ;;
        *)
            show_message "error" "Subcomando desconocido: $subcmd"
            echo "Uso: mb moodlesite {list|enable|disable|create|show|test} [config]"
            return 1
            ;;
    esac
}

# =============================================================================
# MAIN
# =============================================================================

# Filtrar --no-color y --dry-run de args
DRY_RUN="false"
ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--no-color" ]; then
        continue
    elif [ "$arg" = "--dry-run" ]; then
        DRY_RUN="true"
        continue
    fi
    ARGS+=("$arg")
done
set -- "${ARGS[@]}"
export DRY_RUN

[ $# -eq 0 ] && { show_help; exit 0; }

COMMAND="$1"
shift

case "$COMMAND" in
    help|-h|--help)
        show_help
        ;;
    version|-v|--version)
        show_banner
        ;;
    list)
        list_available_configs
        ;;
    backup)
        [ -z "${1:-}" ] && { show_message "error" "$(_ err_usage_backup)"; exit 1; }
        load_moodle_config "$1" || { show_message "error" "$(_ err_config_not_found): $1"; exit 1; }
        if is_backup_running "$INSTANCE_NAME"; then
            # shellcheck disable=SC2059
            show_message "error" "$(printf "$(_ err_backup_running)" "$INSTANCE_NAME")"
            exit 1
        fi
        show_message "info" "$(_ info_running_backup): $1"
        run_full_backup "$1"
        ;;
    run)
        run_background "${1:-}"
        ;;
    moodlesite)
        handle_moodlesite "$@"
        ;;
    logs)
        show_logs "${1:-}"
        ;;
    status)
        show_status
        ;;
    detect)
        show_server_info
        ;;
    test)
        [ -z "${1:-}" ] && { show_message "error" "$(_ err_usage_test)"; exit 1; }
        test_config "$1"
        ;;
    test-email)
        [ -z "${1:-}" ] && { show_message "error" "$(_ err_usage_test_email)"; exit 1; }
        load_moodle_config "$1"
        send_test_email "$1"
        ;;
    cron)
        local_monitor="${MB_INSTALL_DIR}/scripts/cron_monitor.sh"
        if [ -f "$local_monitor" ]; then
            bash "$local_monitor"
        else
            show_message "error" "$(_ err_cron_not_found)"
            exit 1
        fi
        ;;
    health)
        [ -z "${1:-}" ] && { show_message "error" "$(_ err_usage_health)"; exit 1; }
        load_moodle_config "$1" || { show_message "error" "$(_ err_config_not_found): $1"; exit 1; }
        check_heartbeat "$INSTANCE_NAME" "${HEARTBEAT_MAX_HOURS:-24}"
        hb_exit=$?
        case $hb_exit in
            0) show_message "success" "Backup OK - dentro del umbral" ;;
            1) show_message "error" "Backup atrasado - ultimo exito hace mas de ${HEARTBEAT_MAX_HOURS:-24}h" ;;
            2) show_message "warning" "Nunca se ha ejecutado un backup para '$INSTANCE_NAME'" ;;
        esac
        exit $hb_exit
        ;;
    update)
        update_subcmd="${1:-check}"
        case "$update_subcmd" in
            check)
                run_update_check "${2:-}"
                ;;
            install)
                run_update_install "${2:-}"
                ;;
            rollback)
                run_update_rollback
                ;;
            *)
                show_message "error" "Uso: mb update {check|install|rollback} [config]"
                exit 1
                ;;
        esac
        ;;
    *)
        show_message "error" "$(_ err_unknown_cmd): $COMMAND"
        echo ""
        show_help
        exit 1
        ;;
esac
