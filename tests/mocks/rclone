#!/bin/bash
echo "MOCK_RCLONE: $*" >> "${MB_TEST_DIR:-/tmp}/mock_calls.log"

last_arg="${!#}"

case "$1" in
    --version|-V) echo "mock-rclone 1.0" ;;
    listremotes) echo "gdrive:" ;;
    lsd) echo "test-folder/" ;;
    ls)
        case "$last_arg" in
            *.sha256) ;;  # empty = no checksum file
            *) echo "    104857600 test-backup.tar.gz" ;;
        esac
        ;;
    lsf) echo "test-backup.tar.gz" ;;
    cat) echo "mock-file-content" ;;
    rcat) cat >/dev/null ;;
    size)
        case "$2" in
            --json)
                if [ "${MOCK_RCLONE_SIZE_ZERO:-false}" = "true" ]; then
                    echo '{"bytes": 0, "count": 0, "isDir": false}'
                else
                    echo '{"bytes": 5000000000, "count": 1, "isDir": false}'
                fi
                ;;
            *) echo "Total size: 5 GByte" ;;
        esac
        ;;
    delete) true ;;
    mkdir) true ;;
    purge) true ;;
    *) true ;;
esac
exit 0
